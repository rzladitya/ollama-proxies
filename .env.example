# Ollama Proxy Configuration

OLLAMA_PROXY_HOST=127.0.0.1
OLLAMA_PROXY_PORT=11435

OLLAMA_PROXY_DATA_DIR=./data

# REQUIRED — server will not start without these.
# Generate encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OLLAMA_PROXY_ENCRYPTION_KEY=
# Min 8 chars. Used for admin API authentication.
OLLAMA_PROXY_ADMIN_SECRET=

OLLAMA_PROXY_LOG_LEVEL=info
OLLAMA_PROXY_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_PROXY_MAX_ATTEMPTS=3

# Set to true ONLY when running behind a reverse proxy you control (Nginx, Caddy,
# a load balancer) so the admin brute-force lockout sees real client IPs from
# X-Forwarded-For. Leave false when exposed directly — otherwise clients can
# forge their own IP and evade the lockout.
OLLAMA_PROXY_TRUST_PROXY=false
